# ============================================================
# Plataforma Colaborativa de Adopción de Mascotas
# Variables de Entorno de Producción y Desarrollo
# ============================================================

# ------------------------------------------------------------
# Base de Datos (PostgreSQL 16)
# ------------------------------------------------------------
POSTGRES_USER=adopcion_user
POSTGRES_PASSWORD=cambiar_password_seguro_produccion_2026
POSTGRES_DB=adopcion_mascotas
POSTGRES_PORT=5432

# Cadena de conexión interna para Docker (servicio "db")
DATABASE_URL=postgresql://adopcion_user:cambiar_password_seguro_produccion_2026@db:5432/adopcion_mascotas

# Cadena de conexión para desarrollo local (sin Docker)
# DATABASE_URL=postgresql://adopcion_user:cambiar_password_seguro_produccion_2026@localhost:5432/adopcion_mascotas

# ------------------------------------------------------------
# Configuración del Backend API
# ------------------------------------------------------------
NODE_ENV=production
PORT=4000
API_PORT=4000

# Secreto JWT (generar con: openssl rand -base64 48)
JWT_SECRET=super_secreto_jwt_clave_aleatoria_muy_segura_adopcion_zulia_2026
JWT_EXPIRES_IN=24h

# Origen CORS permitido (en producción, colocar el dominio exacto)
CORS_ORIGIN=https://tudominio.com

# Almacenamiento de archivos y fotos
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=5242880

# ------------------------------------------------------------
# Configuración de Dominio y Certificados SSL/TLS
# ------------------------------------------------------------
DOMAIN=tudominio.com
EMAIL=admin@tudominio.com

# ------------------------------------------------------------
# Configuración del Frontend
# ------------------------------------------------------------
EXPO_PUBLIC_API_URL=https://tudominio.com/api
